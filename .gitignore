# --- LaTeX build artifacts (these are never source files) --------------------
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc
*.thm
# beamer (slides/)
*.nav
*.snm
*.vrb

# --- Built manuscript PDF ----------------------------------------------------
# Regenerated by latexmk. Figures in figures/ are tracked, so only ignore the
# built paper, not every PDF.
/paper/*.pdf

# --- packaging staging dirs + archives (package_paper.sh / package_programs.sh)
/paper_package/
/programs_package/
/*.zip
# dated public PDF copies dropped at the project root, e.g. paper_2026-07-04.pdf
/*_[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].pdf

# --- Editor / OS cruft -------------------------------------------------------
*.swp
